# Copy this file to hw4/.env and fill in your own values. Never commit the real .env.
# (The backend also reads ../.env, i.e. a shared parent-folder .env, if present.)

# Required for the chatbot: your Portkey API key
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: Portkey gateway URL (this is the default)
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: model used by the agent (default gpt-5.6-luna)
MODEL_NAME=gpt-5.6-luna

# Optional: secret used to sign login cookies. If unset, a random one is generated
# once into backend/.session_secret (git-ignored).
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: where the append-only audit trail is written (default output/audit_trail.json)
# AUDIT_TRAIL_PATH=output/audit_trail.json

# Frontend (read by Vite when you run `npm run dev`, set it in your shell, not here):
# API_PORT=8000   # backend port the /api proxy forwards to (default 8000)
